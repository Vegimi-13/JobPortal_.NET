@using Microsoft.AspNetCore.Identity
@using JobPortal_ServerSide.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JobPortal</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column h-100 bg-light">

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    JobPortal
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        <!-- Public -->
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Developers" asp-action="Index">Developers</a>
                        </li>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            if (User.IsInRole("Developer"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="DeveloperProfiles" asp-action="Index">
                                        My Profile
                                    </a>
                                </li>
                            }

                            if (User.IsInRole("Company"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-controller="Companies" asp-action="Index">My Company</a>
                                </li>
                            }

                            if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        Admin
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item"
                                               asp-area="Admin"
                                               asp-controller="Dashboard"
                                               asp-action="Index">
                                                <i class="bi bi-speedometer2 me-2"></i>Dashboard
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item"
                                               asp-area=""
                                               asp-controller="DeveloperProfiles"
                                               asp-action="Index">
                                                <i class="bi bi-code-slash me-2"></i>Developer Profiles
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                               asp-area=""
                                               asp-controller="Companies"
                                               asp-action="Index">
                                                <i class="bi bi-building me-2"></i>Company Profiles
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>

                    <!-- Right side -->
                    <ul class="navbar-nav ms-auto">
                        <partial name="_LoginPartial" />
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    
    
    <main role="main" class="flex-shrink-0">
        @RenderBody()
    </main>
    

    <footer class="bg-dark text-white-50 py-4 mt-auto">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    <span class="text-white fw-bold me-2">JobPortal</span>
                    <span>© @DateTime.Now.Year - Connecting developers with opportunities</span>
                </div>
                <div class="col-md-6">
                    <ul class="nav justify-content-center justify-content-md-end">
                        <li class="nav-item">
                            <a asp-area="" asp-controller="Home" asp-action="Index" class="nav-link text-white-50">Home</a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="" asp-controller="Developers" asp-action="Index" class="nav-link text-white-50">Developers</a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="" asp-controller="Home" asp-action="Privacy" class="nav-link text-white-50">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
