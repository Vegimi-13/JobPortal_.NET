@model IEnumerable<JobPortal_ServerSide.Models.DeveloperProfile>

@{
    ViewData["Title"] = "Browse Developers";
}

<div class="container py-5">
    <div class="mb-4">
        <h1 class="fw-bold mb-2">Browse Developers</h1>
        <p class="text-muted">Find talented developers for your team</p>
    </div>

    <div class="card shadow-sm mb-4" style="border-radius: 12px;">
        <div class="card-body p-4">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label fw-semibold small">Search</label>
                    <input name="search" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Name or title..." />
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-semibold small">Location</label>
                    <select name="location" class="form-select">
                        <option value="">All locations</option>
                        @if (ViewBag.Locations != null)
                        {
                            foreach (var loc in ViewBag.Locations)
                            {
                                <option value="@loc" selected="@(loc == ViewBag.CurrentLocation)">@loc</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-semibold small">Skill</label>
                    <select name="skill" class="form-select">
                        <option value="">All skills</option>
                        @if (ViewBag.Skills != null)
                        {
                            foreach (var s in ViewBag.Skills)
                            {
                                <option value="@s.Name" selected="@(s.Name == ViewBag.CurrentSkill)">@s.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label fw-semibold small">Sort</label>
                    <select name="sort" class="form-select">
                        <option value="" selected="@(string.IsNullOrEmpty(ViewBag.CurrentSort))">Name (A-Z)</option>
                        <option value="name_desc" selected="@(ViewBag.CurrentSort == "name_desc")">Name (Z-A)</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-2"></i>Filter
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="mb-3">
                <i class="bi bi-search text-muted" style="font-size: 3rem;"></i>
            </div>
            <h4 class="text-muted">No developers found</h4>
            <p class="text-muted">Try adjusting your search filters</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var dev in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm developer-card" style="border-radius: 12px; border: 2px solid #dee2e6; transition: border-color 0.3s ease;">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-start mb-3">
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center flex-shrink-0 me-3" 
                                     style="width: 56px; height: 56px; font-size: 1.5rem; font-weight: 600;">
                                    @(dev.FullName?.FirstOrDefault().ToString().ToUpper())
                                </div>
                                <div class="flex-grow-1">
                                    <h5 class="card-title mb-1 fw-bold">@dev.FullName</h5>
                                    <p class="text-muted small mb-0">@dev.Title</p>
                                </div>
                            </div>
                            
                            @if (!string.IsNullOrWhiteSpace(dev.Bio))
                            {
                                <p class="card-text text-muted small mb-3" style="min-height: 40px;">
                                    @(dev.Bio.Length > 80 ? dev.Bio.Substring(0, 80) + "..." : dev.Bio)
                                </p>
                            }
                            else
                            {
                                <p class="card-text text-muted small mb-3" style="min-height: 40px;">No bio provided.</p>
                            }

                            @if (dev.DeveloperSkills != null && dev.DeveloperSkills.Any(ds => ds.Skill != null))
                            {
                                <div class="mb-3">
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var ds in dev.DeveloperSkills.Where(s => s.Skill != null).Take(3))
                                        {
                                            <span class="badge rounded-pill bg-dark-subtle text-dark border border-dark-subtle">@ds.Skill.Name</span>
                                        }
                                        @if (dev.DeveloperSkills.Count > 3)
                                        {
                                            <span class="badge rounded-pill bg-secondary-subtle text-secondary border border-secondary-subtle">+@(dev.DeveloperSkills.Count - 3)</span>
                                        }
                                    </div>
                                </div>
                            }
                            
                            @if (!string.IsNullOrWhiteSpace(dev.Location))
                            {
                                <div class="text-muted small mb-3">
                                    <i class="bi bi-geo-alt me-1"></i>@dev.Location
                                </div>
                            }
                            
                            <a asp-action="Details" asp-route-id="@dev.Id" class="btn btn-outline-primary w-100">
                                <i class="bi bi-eye me-1"></i> View Profile
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mt-4 text-muted small">
            Showing @Model.Count() developer@(Model.Count() != 1 ? "s" : "")
        </div>
    }
</div>

<style>
    .developer-card:hover {
        border-color: #0d6efd !important;
    }
</style>
