@model IEnumerable<JobPortal_ServerSide.Models.DeveloperProfile>

<div class="container py-4">
    <h1 class="mb-4 fw-bold">Browse Developers</h1>

    <form method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <input name="search" class="form-control" placeholder="Search by name or title" />
    </div>

    <div class="col-md-3">
        <select name="location" class="form-control">
            <option value="">All locations</option>
            @foreach (var loc in ViewBag.Locations)
            {
                <option value="@loc">@loc</option>
            }
        </select>
    </div>

    <div class="col-md-3">
        <select name="sort" class="form-control">
            <option value="">Name (A-Z)</option>
            <option value="name_desc">Name (Z-A)</option>
        </select>
    </div>

    <div class="col-md-2">
        <button class="btn btn-primary w-100">Filter</button>
    </div>
</form>

<hr />

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        <i class="bi bi-info-circle"></i> No developers found matching your criteria.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var dev in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm developer-card">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3" 
                                 style="width: 50px; height: 50px; font-size: 1.5rem;">
                                @dev.FullName?.FirstOrDefault()
                            </div>
                            <div>
                                <h5 class="card-title mb-0">@dev.FullName</h5>
                                <p class="text-muted small mb-0">@dev.Title</p>
                            </div>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(dev.Bio))
                        {
                            <p class="card-text text-muted small mb-3">
                                @(dev.Bio.Length > 100 ? dev.Bio.Substring(0, 100) + "..." : dev.Bio)
                            </p>
                        }
                        
                        @if (!string.IsNullOrEmpty(dev.Location))
                        {
                            <p class="text-muted small mb-3">
                                <i class="bi bi-geo-alt"></i> @dev.Location
                            </p>
                        }
                        
                        <a asp-action="Details" asp-route-id="@dev.Id" class="btn btn-outline-primary btn-sm w-100">
                            View Profile
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
</div>
