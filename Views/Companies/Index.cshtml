@model IEnumerable<JobPortal_ServerSide.Models.Company>

@{
    ViewData["Title"] = "Companies";
    var isAdmin = User.IsInRole("Admin");
    var companies = Model?.ToList() ?? new List<JobPortal_ServerSide.Models.Company>();
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="mb-1 fw-bold">Company</h1>
            <div class="text-muted">Manage company profiles</div>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Create New
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="card shadow-sm" style="border-radius: 12px; border: 1px solid #e0e0e0;">
        <div class="card-body p-0">
            @if (!companies.Any())
            {
                <div class="p-5 text-center">
                    <h4 class="fw-semibold text-muted">No companies found</h4>
                    <p class="text-muted mb-4">You don't have any company profile yet. Create one to get started.</p>
                    <a asp-action="Create" class="btn btn-primary">Create Company</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Name</th>
                                <th>Description</th>
                                <th>Website</th>
                                <th>Location</th>
                                <th>Status</th>
                                @if (isAdmin)
                                {
                                    <th>User</th>
                                }
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in companies)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">@item.Name</td>
                                    <td style="max-width: 320px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.Website))
                                        {
                                            var href = item.Website.StartsWith("http", System.StringComparison.OrdinalIgnoreCase) ? item.Website : "https://" + item.Website;
                                            <a href="@href" target="_blank" rel="noopener">@item.Website</a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Location) ? "—" : item.Location)</td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-secondary-subtle text-secondary border border-secondary-subtle">Inactive</span>
                                        }
                                    </td>
                                    @if (isAdmin)
                                    {
                                        <td class="small text-muted">@item.User?.Email</td>
                                    }
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary">Details</a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary">Edit</a>
                                            @if (isAdmin)
                                            {
                                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">Delete</a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
