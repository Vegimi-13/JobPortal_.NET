@model JobPortal_ServerSide.Models.Company

@{
    ViewData["Title"] = "Delete Company";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow-sm" style="border-radius: 12px;">
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <h2 class="fw-bold mb-2">Delete Company</h2>
                        <p class="text-muted mb-0">This action cannot be undone</p>
                    </div>

                    <div class="alert alert-danger" role="alert">
                        <i class="bi bi-exclamation-circle me-2"></i>
                        <strong>Warning:</strong> You are about to permanently delete this company profile.
                    </div>

                    <div class="mb-4">
                        <h5 class="fw-semibold mb-3">Company Information</h5>
                        <div class="p-3 bg-light rounded">
                            <div class="row g-2">
                                <div class="col-12">
                                    <div class="d-flex justify-content-between">
                                        <span class="text-muted small">Name</span>
                                        <span class="fw-semibold">@Model.Name</span>
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(Model.Description))
                                {
                                    <div class="col-12">
                                        <hr class="my-2">
                                        <div class="d-flex justify-content-between">
                                            <span class="text-muted small">Description</span>
                                            <span class="fw-semibold">@Model.Description</span>
                                        </div>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.Website))
                                {
                                    <div class="col-12">
                                        <hr class="my-2">
                                        <div class="d-flex justify-content-between">
                                            <span class="text-muted small">Website</span>
                                            <span class="fw-semibold">@Model.Website</span>
                                        </div>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.Location))
                                {
                                    <div class="col-12">
                                        <hr class="my-2">
                                        <div class="d-flex justify-content-between">
                                            <span class="text-muted small">Location</span>
                                            <span class="fw-semibold">@Model.Location</span>
                                        </div>
                                    </div>
                                }
                                <div class="col-12">
                                    <hr class="my-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-muted small">Status</span>
                                        @if (Model.IsActive)
                                        {
                                            <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-secondary-subtle text-secondary border border-secondary-subtle">Inactive</span>
                                        }
                                    </div>
                                </div>
                                @if (User.IsInRole("Admin") && Model.User != null)
                                {
                                    <div class="col-12">
                                        <hr class="my-2">
                                        <div class="d-flex justify-content-between">
                                            <span class="text-muted small">Owner</span>
                                            <span class="fw-semibold small">@Model.User.Email</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger btn-lg flex-fill">
                                <i class="bi bi-trash me-1"></i> Delete Permanently
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg flex-fill">
                                <i class="bi bi-x-lg me-1"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
