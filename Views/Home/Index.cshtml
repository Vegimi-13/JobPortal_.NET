@{
    ViewData["Title"] = "Home";
}

<!-- HERO SECTION -->
<section class="hero-section text-white py-5">
    <div class="container py-4">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h1 class="display-4 fw-bold">Find Developers. <br />Show Your Skills.</h1>
                <p class="lead mt-3">
                    JobPortal is a platform where developers build professional profiles
                    and companies discover talent.
                </p>

                <div class="mt-4">
                    <a asp-controller="Developers" asp-action="Index" class="btn btn-primary btn-lg me-2">
                        Browse Developers
                    </a>

                    @if (!User.Identity.IsAuthenticated)
                    {
                        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-light btn-lg">
                            Join as Developer
                        </a>
                    }
                </div>
            </div>

            <div class="col-md-6 text-center">
                <img src="https://cdn-icons-png.flaticon.com/512/1006/1006363.png"
                     class="img-fluid"
                     style="max-height:300px"
                     alt="developers" />
            </div>
        </div>
    </div>
</section>

<!-- FEATURES -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">What you can do</h2>
            <p class="text-muted">A simple platform with powerful features.</p>
        </div>

        <div class="row g-4 text-center">
            <div class="col-md-4">
                <div class="card h-100 shadow-sm feature-card">
                    <div class="card-body">
                        <h5 class="card-title">Create a Developer Profile</h5>
                        <p class="card-text text-muted">
                            Showcase your skills, experience and projects in one professional profile.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow-sm feature-card">
                    <div class="card-body">
                        <h5 class="card-title">Discover Talent</h5>
                        <p class="card-text text-muted">
                            Companies can browse developers, filter by skills and find the right match.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow-sm feature-card">
                    <div class="card-body">
                        <h5 class="card-title">Admin Management</h5>
                        <p class="card-text text-muted">
                            Admin dashboard to manage users, profiles and system activity.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CALL TO ACTION -->
<section class="py-5 text-center">
    <div class="container">
        <h2 class="fw-bold">Ready to get started?</h2>
        <p class="text-muted mt-2">Create your account and build your developer profile today.</p>

        @if (!User.Identity.IsAuthenticated)
        {
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary btn-lg mt-3">
                Create free account
            </a>
        }
        else
        {
            <a asp-controller="Developers" asp-action="Index" class="btn btn-primary btn-lg mt-3">
                Browse Developers
            </a>
        }
    </div>
</section>
